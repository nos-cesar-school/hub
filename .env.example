# Endpoint público de submissão do Form View do NocoDB (sem xc-token!)
# Exemplo: https://app.nocodb.com/api/v2/public/shared-view/SEU-SHARED-VIEW-UUID/rows
# IMPORTANTE: Compartilhe APENAS uma visualização do tipo "Form" (nunca "Grid"), pois variáveis VITE_ são públicas no navegador.
VITE_NOCODB_FORM_ENDPOINT=

# Canais institucionais opcionais (quando preenchidos, ativam automaticamente os cards e ícones em todas as páginas)
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_CONTACT_EMAIL=
